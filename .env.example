# Variáveis de ambiente — Top Trade Multimarcas
# Copiar para .env.local (nunca versionar valores reais) e preencher com os
# dados de Settings -> API no painel do projeto Supabase.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Analytics 4 — opcional. Sem isso definido, o site funciona
# normalmente e o Analytics simplesmente não carrega.
# Criar em analytics.google.com -> Admin -> Criar propriedade -> Fluxo Web
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
